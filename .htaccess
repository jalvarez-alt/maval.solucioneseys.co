# MAVAL - configuración Apache (Namecheap / cPanel)
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Forzar HTTPS (descomente cuando el certificado SSL esté activo)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteRule ^(app|sql)(/|$) - [F,L]
</IfModule>

<FilesMatch "\.(sqlite|sql|md|log|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_php.c>
  php_value upload_max_filesize 12M
  php_value post_max_size 14M
</IfModule>
